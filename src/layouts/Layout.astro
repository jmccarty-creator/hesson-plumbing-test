---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hesson Plumbing & Drains | Central Ohio',
  description = "Hesson Plumbing & Drains — Central Ohio's trusted plumber for 20+ years. Available 24/7. Call (740) 304-4195.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <header class="nav" id="nav">
      <div class="container nav__inner">
        <a href="/" class="nav__logo">
          <img src="/logo1.png" alt="Hesson Plumbing & Drains" class="nav__logo-img" />
        </a>
        <div class="nav__right">
          <nav class="nav__links">
            <a href="/">Home</a>
            <a href="/services">Services</a>
            <a href="/drain-cleaning">Drain Cleaning</a>
            <a href="/contact">Contact</a>
          </nav>
          <a href="tel:7403044195" class="btn-primary nav__cta">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.93-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.72 17z"/></svg>
            (740) 304-4195
          </a>
        </div>
        <button class="nav__hamburger" id="hamburger" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="nav__mobile" id="mobileMenu">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/drain-cleaning">Drain Cleaning</a>
        <a href="/contact">Contact</a>
        <a href="tel:7403044195" class="btn-primary">Call (740) 304-4195</a>
      </div>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <div class="container footer__inner">
        <div class="footer__top">
          <div class="footer__brand">
            <img src="/logo1.png" alt="Hesson Plumbing & Drains" class="footer__logo" />
            <p>Your neighborhood plumber, done right.</p>
            <p class="footer__license">Licensed &amp; Insured · Central Ohio</p>
          </div>
          <div class="footer__col">
            <p class="footer__heading">Navigation</p>
            <a href="/">Home</a>
            <a href="/services">Services</a>
            <a href="/drain-cleaning">Drain Cleaning</a>
            <a href="/contact">Contact</a>
          </div>
          <div class="footer__col">
            <p class="footer__heading">Contact</p>
            <a href="tel:7403044195">(740) 304-4195</a>
            <a href="mailto:david@hessonplumbing.com">david@hessonplumbing.com</a>
            <a href="https://www.google.com/maps/dir/?api=1&destination=4299+Professional+Pkwy+Groveport+OH+43125" target="_blank">4299 Professional Pkwy<br />Groveport, OH 43125</a>
          </div>
          <div class="footer__col">
            <p class="footer__heading">Emergency</p>
            <p class="footer__emergency">Available<br />24 / 7</p>
            <a href="tel:7403044195" class="btn-primary footer__call">Call Now</a>
          </div>
        </div>
        <div class="footer__bottom">
          <p>&copy; 2025 Hesson Plumbing &amp; Drains LLC. All rights reserved.</p>
          <p>Serving Groveport, Pickerington &amp; Central Ohio</p>
        </div>
      </div>
    </footer>

    <script>
      // Sticky nav
      const nav = document.getElementById('nav')!;
      window.addEventListener('scroll', () => {
        nav.classList.toggle('nav--scrolled', window.scrollY > 40);
      });

      // Mobile menu
      const hamburger = document.getElementById('hamburger')!;
      const mobileMenu = document.getElementById('mobileMenu')!;
      hamburger.addEventListener('click', () => {
        mobileMenu.classList.toggle('open');
        hamburger.classList.toggle('open');
      });

      // Scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right')
        .forEach(el => observer.observe(el));

      // Counter animation
      function animateCounter(el: Element) {
        const target = parseInt(el.getAttribute('data-target') || '0');
        const suffix = el.getAttribute('data-suffix') || '';
        const duration = 1800;
        const start = performance.now();
        const update = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(update);
        };
        requestAnimationFrame(update);
      }

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            animateCounter(e.target);
            counterObserver.unobserve(e.target);
          }
        });
      }, { threshold: 0.5 });

      document.querySelectorAll('[data-target]').forEach(el => counterObserver.observe(el));
    </script>

  </body>
</html>

<style>
  /* ── NAV ── */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    transition: background 0.4s, border-color 0.4s;
    border-bottom: 1px solid transparent;
  }

  .nav--scrolled {
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(16px);
    border-color: var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    height: 100px;
    gap: 40px;
  }

  .nav__logo { flex-shrink: 0; }
  .nav__logo-img {
    height: 118px;
    width: auto;
    object-fit: contain;
    margin-top: 32px;
  }

  .nav__right {
    display: flex;
    align-items: center;
    margin-left: auto;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 6px 6px 6px 28px;
    gap: 32px;
  }

  .nav__links {
    display: flex;
    gap: 32px;
  }

  .nav__links a {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.75);
    transition: color 0.2s;
    white-space: nowrap;
  }

  .nav__links a:hover { color: var(--blue-light); }

  .nav__cta { font-size: 13px; padding: 11px 22px; flex-shrink: 0; }

  .nav__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }

  .nav__hamburger span {
    display: block; width: 24px; height: 2px;
    background: var(--white);
    transition: transform 0.25s, opacity 0.25s;
  }

  .nav__hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__hamburger.open span:nth-child(2) { opacity: 0; }
  .nav__hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav__mobile {
    display: none;
    flex-direction: column;
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 16px 32px 28px;
    gap: 0;
  }

  .nav__mobile a {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--white);
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .nav__mobile .btn-primary { margin-top: 20px; justify-content: center; }
  .nav__mobile.open { display: flex; }

  /* ── FOOTER ── */
  .footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-top: 72px;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--border);
  }

  .footer__logo {
    height: 100px;
    width: auto;
    object-fit: contain;
    margin-bottom: 16px;
  }

  .footer__brand p {
    font-size: 14px;
    color: var(--white);
    line-height: 1.6;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .footer__license {
    font-size: 12px !important;
    color: var(--white) !important;
    margin-top: 8px;
  }

  .footer__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--blue-light) !important;
    margin-bottom: 18px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__col a, .footer__col p {
    font-size: 14px;
    color: var(--grey);
    transition: color 0.2s;
    line-height: 1.6;
  }

  .footer__col a:hover { color: var(--blue-light); }

  .footer__emergency {
    font-family: 'Bebas Neue', sans-serif !important;
    font-size: 36px !important;
    line-height: 1 !important;
    color: var(--white) !important;
    margin-bottom: 4px;
  }

  .footer__call { margin-top: 8px; font-size: 13px; padding: 10px 20px; color: #000000 !important; justify-content: center; }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    padding: 20px 0;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer__bottom p {
    font-size: 12px;
    color: var(--grey-dim);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .nav__right { display: none; }
    .nav__hamburger { display: flex; }

    .footer__top { grid-template-columns: 1fr 1fr; gap: 32px; }
  }

  @media (max-width: 600px) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__bottom { flex-direction: column; align-items: center; text-align: center; }
  }
</style>
