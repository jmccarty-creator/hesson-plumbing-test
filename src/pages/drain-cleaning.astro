  <script>
    (function () {
      const heroBg = document.querySelector('.dc-hero__photo') as HTMLElement | null;
      const hydroBg = document.querySelector('.dc-hydro__bg') as HTMLElement | null;

      function onScroll() {
        const scrollY = window.scrollY;
        if (heroBg) heroBg.style.backgroundPositionY = `calc(50% + ${scrollY * 0.35}px)`;
        if (hydroBg) {
          const rect = (hydroBg.parentElement as HTMLElement).getBoundingClientRect();
          const offset = (window.innerHeight / 2 - rect.top - rect.height / 2) * 0.3;
          hydroBg.style.backgroundPositionY = `calc(50% + ${offset}px)`;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>

