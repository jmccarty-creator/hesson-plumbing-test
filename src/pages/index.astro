  <script>
    (function () {
      const photo = document.querySelector('.page-hero__photo') as HTMLElement | null;

      function onScroll() {
        const scrollY = window.scrollY;
        if (photo) {
          photo.style.backgroundPositionY = `calc(50% + ${scrollY * 0.35}px)`;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>

</Layout>

<style>
  /* ══ HERO ══ */
  .page-hero {
    background: var(--black);
    min-height: 62vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .page-hero__photo {
    position: absolute;
    inset: 0;
    background-image: url('/hero-bg.jpg');
    background-size: cover;
    background-position: center center;
    opacity: 0.18;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }

  .page-hero__noise {
    position: absolute; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    opacity: 0.4;
    pointer-events: none;
  }

  .page-hero__glow {
    position: absolute;
    top: -200px; right: -200px;
    width: 800px; height: 800px;
    background: radial-gradient(circle, rgba(15,54,125,0.35) 0%, transparent 70%);
    pointer-events: none;
  }

  .page-hero__glow--left {
    top: auto; right: auto;
    bottom: -150px; left: -100px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(15,54,125,0.2) 0%, transparent 70%);
  }

  .page-hero__inner {
    position: relative; z-index: 1;
    padding: 80px 0 120px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
  }

  .page-hero__headline { display: flex; flex-direction: column; gap: 12px; }

  .page-hero h1 {
    font-size: clamp(120px, 18vw, 240px);
    line-height: 0.88;
    color: var(--white);
    opacity: 0;
    transform: translateY(40px);
    animation: heroLine 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  .page-hero h1 span {
    color: transparent;
    -webkit-text-stroke: 3px var(--blue-light);
    display: block;
    text-shadow: none;
  }

  .page-hero__sub {
    font-size: 17px;
    color: var(--grey);
    line-height: 1.75;
    opacity: 0;
    animation: heroLine 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
  }

  @keyframes heroLine {
    to { opacity: 1; transform: translateY(0); }
  }

  /* CTA row */
  .page-hero__cta-row {
    display: flex;
