---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- ══════════════════════════════════
       HERO
  ══════════════════════════════════ -->
  <section class="page-hero">
    <div class="page-hero__photo"></div>
    <div class="page-hero__noise"></div>
    <div class="page-hero__glow"></div>
    <div class="page-hero__glow page-hero__glow--left"></div>

    <div class="container page-hero__inner">

      <!-- BIG TYPE -->
      <div class="page-hero__headline">
        <h1>Hesson Plumbing<br /><span>&amp; Drains</span></h1>
        <p class="page-hero__sub">Central Ohio's trusted plumber for 25+ years.<br />Available 24/7 for emergencies, repairs, drain cleaning, and more.</p>
      </div>

      <!-- CTA ROW -->
      <div class="page-hero__cta-row">
        <a href="tel:7403044195" class="btn-primary page-hero__btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.93-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.72 17z"/></svg>
          Call Now
        </a>
        <a href="/contact" class="btn-ghost">Request Service</a>
        <div class="page-hero__trust">
          <span>✓ Licensed &amp; Insured</span>
          <span>✓ Financing Available</span>
          <span>✓ Central Ohio</span>
        </div>
      </div>

      <!-- CARDS ROW -->
      <div class="page-hero__cards">
        <div class="page-hero__card page-hero__card--years">
          <span class="page-hero__card-num" data-target="25" data-suffix="+">0+</span>
          <span class="page-hero__card-label">Years<br />Experience</span>
        </div>

        <div class="page-hero__card page-hero__card--emergency">
          <div class="page-hero__card-dot"></div>
          <p class="page-hero__card-title">Emergency Line</p>
          <a href="tel:7403044195" class="page-hero__card-phone">(740) 304-4195</a>
        </div>

        <div class="page-hero__card page-hero__card--available">
          <span class="page-hero__card-big">24/7</span>
          <span class="page-hero__card-small">Available Now</span>
        </div>
      </div>

    </div>

  </section>

  <!-- ══════════════════════════════════
       STATS BAR
  ══════════════════════════════════ -->
  <section class="stats-bar">
    <div class="container stats-bar__inner">
      <div class="stats-bar__item reveal">
        <span class="stats-bar__num" data-target="25" data-suffix="+">0+</span>
        <span class="stats-bar__label">Years in Business</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__item reveal delay-1">
        <span class="stats-bar__num">24/7</span>
        <span class="stats-bar__label">Emergency Service</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__item reveal delay-2">
        <span class="stats-bar__num">Same</span>
        <span class="stats-bar__label">Day Service</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__item reveal delay-3">
        <span class="stats-bar__num">Ohio</span>
        <span class="stats-bar__label">Licensed &amp; Insured</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       ABOUT
  ══════════════════════════════════ -->
  <section class="about">
    <div class="container about__grid">

      <div class="about__left reveal-left">
        <div class="about__img-wrap">
          <div class="about__img-placeholder">
            <img src="/about.png" alt="Hesson Plumbing & Drains" class="about__photo" />
          </div>
          <div class="about__img-accent"></div>
        </div>
      </div>

      <div class="about__right">
        <p class="eyebrow reveal">About Us</p>
        <h2 class="reveal delay-1">Locally Owned.<br /><span>Family Operated.</span></h2>
        <p class="about__body reveal delay-2">
          At Hesson Plumbing &amp; Drains, we're a locally owned and family-operated company with over 25 years of experience delivering dependable plumbing solutions. We take pride in providing honest, high-quality service, whether it's routine maintenance, drain cleaning, or more complex repairs and installations.
        </p>
        <p class="about__body reveal delay-3">
          We understand how important a properly functioning plumbing system is to your home or business, which is why we respond promptly, work efficiently, and stand behind every job we complete. Built on a foundation of trust, reliability, and strong community values, we're committed to doing the job right the first time and treating every customer like family.
        </p>

        <div class="about__actions reveal delay-4">
          <a href="/contact" class="btn-primary">Request Service</a>
          <a href="tel:7403044195" class="about__phone">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.93-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.72 17z"/></svg>
            (740) 304-4195
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════
       SERVICES
  ══════════════════════════════════ -->
  <section class="services">
    <div class="services__video-wrap">
      <video class="services__video" autoplay muted loop playsinline>
        <source src="/services-bg.mp4" type="video/mp4" />
      </video>
      <div class="services__video-overlay"></div>
    </div>
    <div class="container">
      <div class="services__header reveal">
        <p class="eyebrow">What We Do</p>
        <h2>Full-Service Plumbing<br /><span>&amp; Drain Solutions</span></h2>
      </div>

      <div class="services__grid">
        <a href="/services" class="svc reveal delay-1">
          <div class="svc__num">01</div>
          <h3>Drain Services</h3>
          <p>Fast clearing of clogs and slow drains. Same-day service available across Central Ohio.</p>
          <div class="svc__arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </a>

        <a href="/services" class="svc reveal delay-2">
          <div class="svc__num">02</div>
          <h3>Faucet Services</h3>
          <p>Indoor &amp; outdoor repair, upgrades, and new installations done right.</p>
          <div class="svc__arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </a>

        <a href="/services" class="svc reveal delay-3">
          <div class="svc__num">03</div>
          <h3>Water Heater Services</h3>
          <p>Repair and replacement for any make and model. Hot water restored fast.</p>
          <div class="svc__arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </a>

        <a href="/services" class="svc reveal delay-1">
          <div class="svc__num">04</div>
          <h3>Water Lines</h3>
          <p>New installations and repairs for clean, reliable water delivery.</p>
          <div class="svc__arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </a>

        <a href="/services" class="svc reveal delay-2">
          <div class="svc__num">05</div>
          <h3>Sewer Services</h3>
          <p>Sewer line cleaning, repair, and camera inspection by licensed professionals.</p>
          <div class="svc__arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </a>

        <a href="/services" class="svc reveal delay-3">
          <div class="svc__num">06</div>
          <h3>Garbage Disposal Services</h3>
          <p>Installation, repair, and replacement of garbage disposals done quickly and correctly.</p>
          <div class="svc__arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </a>
      </div>

      <div class="services__footer reveal">
        <a href="/services" class="btn-ghost">View All Services</a>
      </div>
    </div>
  </section>

